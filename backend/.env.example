# Configure via variáveis de ambiente ou use 'source' no terminal
PORT=3000
# Para Expo Go, backend acessível na mesma rede Wi-Fi
# Caminho default do banco: backend/data/pixelstore.sqlite
# DB_PATH=/caminho/banco.sqlite
# MODO DEMONSTRACAO: autoriza simular pagamentos sem transação financeira
ENABLE_DEMO_CHECKOUT=1
# Para Checkout Pro REAL, insira token de TESTE da sua conta (NUNCA no app)
# MERCADOPAGO_ACCESS_TOKEN=TEST-...
